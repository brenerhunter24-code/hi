<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>ORBIT</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Major+Mono+Display&family=JetBrains+Mono:wght@300;500;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body {
    height: 100%; width: 100%; overflow: hidden;
    background: #05030d;
    font-family: 'JetBrains Mono', monospace;
    color: #e8d8ff;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }
  #game {
    position: fixed; inset: 0;
    display: block;
    cursor: pointer;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(120, 50, 180, 0.25), transparent 50%),
      radial-gradient(ellipse at 70% 80%, rgba(40, 100, 200, 0.2), transparent 50%),
      linear-gradient(180deg, #05030d 0%, #0a0518 100%);
  }
  .ui {
    position: fixed;
    pointer-events: none;
    z-index: 10;
  }
  #hud {
    top: 28px; left: 0; right: 0;
    display: flex; justify-content: space-between;
    padding: 0 28px;
    font-size: 13px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  #score-label { color: #b8a8d8; }
  #score-value {
    color: #fff;
    font-weight: 700;
    text-shadow: 0 0 12px rgba(255, 100, 220, 0.6);
  }
  #best { color: #b8a8d8; }
  #screen {
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: radial-gradient(ellipse at center, rgba(10, 5, 25, 0.4) 0%, rgba(5, 3, 13, 0.85) 70%);
    backdrop-filter: blur(2px);
    transition: opacity 0.4s ease;
  }
  #screen.hidden { opacity: 0; pointer-events: none; }
  .title {
    font-family: 'Major Mono Display', monospace;
    font-size: clamp(64px, 18vw, 140px);
    letter-spacing: 0.15em;
    color: #fff;
    text-shadow:
      0 0 30px rgba(255, 100, 220, 0.5),
      0 0 60px rgba(120, 80, 220, 0.3);
    margin-bottom: 8px;
  }
  .subtitle {
    font-size: 11px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: #a090c8;
    margin-bottom: 48px;
  }
  .instr {
    font-size: 14px;
    letter-spacing: 0.15em;
    color: #d8c8f0;
    line-height: 1.8;
    margin-bottom: 48px;
    max-width: 280px;
  }
  .instr span {
    color: #ff64dc;
    font-weight: 500;
  }
  .btn {
    pointer-events: auto;
    background: transparent;
    border: 1px solid rgba(232, 216, 255, 0.4);
    color: #fff;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    padding: 18px 40px;
    cursor: pointer;
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }
  .btn:hover, .btn:active {
    border-color: #ff64dc;
    color: #ff64dc;
    box-shadow: 0 0 24px rgba(255, 100, 220, 0.3);
  }
  .stat-line {
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #a090c8;
    margin: 6px 0;
  }
  .stat-line b {
    color: #fff;
    font-weight: 500;
    margin-left: 12px;
  }
  .pulse {
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  #flash {
    position: fixed;
    inset: 0;
    background: #ff64dc;
    opacity: 0;
    pointer-events: none;
    z-index: 5;
    mix-blend-mode: screen;
  }
</style>
</head>
<body>
<canvas id="game"></canvas>
<div id="flash"></div>

<div class="ui" id="hud" style="display:none;">
  <div><span id="score-label">Score</span> <span id="score-value">0</span></div>
  <div id="best">Best 0</div>
</div>

<div class="ui" id="screen">
  <div class="title">orbit</div>
  <div class="subtitle pulse">a one-tap arcade</div>
  <div class="instr">
    tap <span>anywhere</span> to reverse direction.<br>
    avoid the asteroids.<br>
    survive.
  </div>
  <button class="btn" id="start-btn">Begin</button>
</div>

<div class="ui" id="gameover" style="display:none;">
  <div style="font-family: 'Major Mono Display'; font-size: clamp(40px, 10vw, 72px); letter-spacing: 0.2em; color: #ff64dc; margin-bottom: 32px; text-shadow: 0 0 30px rgba(255, 100, 220, 0.6);">lost</div>
  <div class="stat-line">Score <b id="final-score">0</b></div>
  <div class="stat-line">Best <b id="final-best">0</b></div>
  <div style="margin-top: 48px;">
    <button class="btn" id="restart-btn">Again</button>
  </div>
</div>

<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const hud = document.getElementById('hud');
const screen = document.getElementById('screen');
const gameover = document.getElementById('gameover');
const scoreValue = document.getElementById('score-value');
const bestEl = document.getElementById('best');
const finalScore = document.getElementById('final-score');
const finalBest = document.getElementById('final-best');
const flash = document.getElementById('flash');

let W, H, cx, cy;
function resize() {
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  W = canvas.clientWidth = window.innerWidth;
  H = canvas.clientHeight = window.innerHeight;
  canvas.width = W * dpr;
  canvas.height = H * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  cx = W / 2; cy = H / 2;
}
window.addEventListener('resize', resize);
resize();

// State
let state = 'menu'; // menu | playing | over
let score = 0;
let best = +localStorage.getItem('orbit-best') || 0;
bestEl.textContent = 'Best ' + best;

// Player
const player = {
  angle: -Math.PI / 2,
  radius: 110,
  speed: 0.04,
  dir: 1,
  trail: []
};

// World
let stars = [];
let asteroids = [];
let particles = [];
let pulses = [];
let frame = 0;
let spawnTimer = 0;
let baseSpawnInterval = 70;
let difficulty = 1;
let shake = 0;

function initStars() {
  stars = [];
  for (let i = 0; i < 110; i++) {
    stars.push({
      x: Math.random() * W,
      y: Math.random() * H,
      r: Math.random() * 1.4 + 0.2,
      a: Math.random() * 0.6 + 0.2,
      tw: Math.random() * 0.02 + 0.005,
      ph: Math.random() * Math.PI * 2
    });
  }
}
initStars();
window.addEventListener('resize', initStars);

function reset() {
  player.angle = -Math.PI / 2;
  player.radius = Math.min(W, H) * 0.28;
  player.dir = 1;
  player.trail = [];
  asteroids = [];
  particles = [];
  pulses = [];
  score = 0;
  difficulty = 1;
  spawnTimer = 0;
  frame = 0;
  shake = 0;
}

function startGame() {
  reset();
  state = 'playing';
  screen.classList.add('hidden');
  gameover.style.display = 'none';
  hud.style.display = 'flex';
}

function endGame() {
  state = 'over';
  hud.style.display = 'none';
  if (score > best) {
    best = score;
    localStorage.setItem('orbit-best', best);
  }
  finalScore.textContent = score;
  finalBest.textContent = best;
  bestEl.textContent = 'Best ' + best;
  gameover.style.display = 'flex';
  gameover.style.flexDirection = 'column';
  gameover.style.alignItems = 'center';
  gameover.style.justifyContent = 'center';
  gameover.style.position = 'fixed';
  gameover.style.inset = '0';
  gameover.style.background = 'radial-gradient(ellipse at center, rgba(10, 5, 25, 0.5) 0%, rgba(5, 3, 13, 0.9) 70%)';
  gameover.style.backdropFilter = 'blur(3px)';
  // flash
  flash.style.transition = 'none';
  flash.style.opacity = '0.5';
  requestAnimationFrame(() => {
    flash.style.transition = 'opacity 0.6s ease-out';
    flash.style.opacity = '0';
  });
}

function tap() {
  if (state === 'playing') {
    player.dir *= -1;
    pulses.push({ x: cx, y: cy, r: player.radius, a: 0.6 });
  }
}

canvas.addEventListener('pointerdown', (e) => {
  e.preventDefault();
  tap();
});
window.addEventListener('keydown', (e) => {
  if (e.code === 'Space') { e.preventDefault(); tap(); }
});

document.getElementById('start-btn').addEventListener('click', startGame);
document.getElementById('restart-btn').addEventListener('click', startGame);

function spawnAsteroid() {
  // spawn from edge, aim near orbit
  const edge = Math.floor(Math.random() * 4);
  let x, y;
  if (edge === 0) { x = -30; y = Math.random() * H; }
  else if (edge === 1) { x = W + 30; y = Math.random() * H; }
  else if (edge === 2) { x = Math.random() * W; y = -30; }
  else { x = Math.random() * W; y = H + 30; }
  // target a random point near orbit
  const targetAngle = Math.random() * Math.PI * 2;
  const tx = cx + Math.cos(targetAngle) * player.radius;
  const ty = cy + Math.sin(targetAngle) * player.radius;
  const dx = tx - x, dy = ty - y;
  const d = Math.hypot(dx, dy);
  const speed = (1.4 + difficulty * 0.18) + Math.random() * 0.8;
  asteroids.push({
    x, y,
    vx: dx / d * speed,
    vy: dy / d * speed,
    r: 8 + Math.random() * 7,
    rot: Math.random() * Math.PI * 2,
    rotSpeed: (Math.random() - 0.5) * 0.05,
    points: (() => {
      const n = 7 + Math.floor(Math.random() * 3);
      const arr = [];
      for (let i = 0; i < n; i++) {
        arr.push(0.7 + Math.random() * 0.5);
      }
      return arr;
    })()
  });
}

function explode(x, y, color) {
  for (let i = 0; i < 24; i++) {
    const a = Math.random() * Math.PI * 2;
    const s = Math.random() * 4 + 1;
    particles.push({
      x, y,
      vx: Math.cos(a) * s,
      vy: Math.sin(a) * s,
      life: 1,
      decay: 0.02 + Math.random() * 0.02,
      r: Math.random() * 2 + 1,
      color: color || '#ff64dc'
    });
  }
}

function loop() {
  frame++;
  ctx.clearRect(0, 0, W, H);

  // shake
  let sx = 0, sy = 0;
  if (shake > 0) {
    sx = (Math.random() - 0.5) * shake;
    sy = (Math.random() - 0.5) * shake;
    shake *= 0.88;
  }
  ctx.save();
  ctx.translate(sx, sy);

  // stars
  for (const s of stars) {
    s.ph += s.tw;
    const a = s.a * (0.6 + Math.sin(s.ph) * 0.4);
    ctx.fillStyle = `rgba(220, 200, 255, ${a})`;
    ctx.beginPath();
    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
    ctx.fill();
  }

  // central planet
  const planetR = 38;
  const pulseR = planetR + Math.sin(frame * 0.04) * 3;
  // glow
  const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, pulseR * 3);
  grad.addColorStop(0, 'rgba(180, 100, 255, 0.5)');
  grad.addColorStop(0.3, 'rgba(120, 60, 200, 0.15)');
  grad.addColorStop(1, 'rgba(60, 30, 120, 0)');
  ctx.fillStyle = grad;
  ctx.beginPath();
  ctx.arc(cx, cy, pulseR * 3, 0, Math.PI * 2);
  ctx.fill();
  // planet body
  const pgrad = ctx.createRadialGradient(cx - 10, cy - 10, 2, cx, cy, pulseR);
  pgrad.addColorStop(0, '#e8a8ff');
  pgrad.addColorStop(0.5, '#9050d8');
  pgrad.addColorStop(1, '#3a1878');
  ctx.fillStyle = pgrad;
  ctx.beginPath();
  ctx.arc(cx, cy, pulseR, 0, Math.PI * 2);
  ctx.fill();

  // orbit ring (faint)
  if (state === 'playing' || state === 'menu') {
    ctx.strokeStyle = 'rgba(232, 216, 255, 0.08)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    const r = state === 'menu' ? Math.min(W, H) * 0.28 : player.radius;
    ctx.arc(cx, cy, r, 0, Math.PI * 2);
    ctx.stroke();
  }

  // pulses (tap feedback)
  for (let i = pulses.length - 1; i >= 0; i--) {
    const p = pulses[i];
    p.r += 4;
    p.a -= 0.025;
    if (p.a <= 0) { pulses.splice(i, 1); continue; }
    ctx.strokeStyle = `rgba(255, 100, 220, ${p.a})`;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
    ctx.stroke();
  }

  if (state === 'playing') {
    // update player
    player.angle += player.speed * player.dir;
    const px = cx + Math.cos(player.angle) * player.radius;
    const py = cy + Math.sin(player.angle) * player.radius;

    // trail
    player.trail.push({ x: px, y: py, life: 1 });
    if (player.trail.length > 20) player.trail.shift();
    for (let i = 0; i < player.trail.length; i++) {
      const t = player.trail[i];
      const a = (i / player.trail.length) * 0.7;
      ctx.fillStyle = `rgba(100, 220, 255, ${a})`;
      ctx.beginPath();
      ctx.arc(t.x, t.y, 2 + (i / player.trail.length) * 4, 0, Math.PI * 2);
      ctx.fill();
    }

    // player ship
    const playerGlow = ctx.createRadialGradient(px, py, 0, px, py, 16);
    playerGlow.addColorStop(0, 'rgba(180, 240, 255, 1)');
    playerGlow.addColorStop(0.4, 'rgba(100, 220, 255, 0.6)');
    playerGlow.addColorStop(1, 'rgba(60, 180, 255, 0)');
    ctx.fillStyle = playerGlow;
    ctx.beginPath();
    ctx.arc(px, py, 16, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#fff';
    ctx.beginPath();
    ctx.arc(px, py, 5, 0, Math.PI * 2);
    ctx.fill();

    // spawn asteroids
    spawnTimer++;
    const interval = Math.max(20, baseSpawnInterval - difficulty * 4);
    if (spawnTimer >= interval) {
      spawnTimer = 0;
      spawnAsteroid();
      if (Math.random() < Math.min(0.6, difficulty * 0.08)) spawnAsteroid();
    }

    // update asteroids
    for (let i = asteroids.length - 1; i >= 0; i--) {
      const a = asteroids[i];
      a.x += a.vx;
      a.y += a.vy;
      a.rot += a.rotSpeed;

      // off screen cleanup
      if (a.x < -80 || a.x > W + 80 || a.y < -80 || a.y > H + 80) {
        asteroids.splice(i, 1);
        continue;
      }

      // collision with player
      const dx = a.x - px, dy = a.y - py;
      if (dx * dx + dy * dy < (a.r + 6) * (a.r + 6)) {
        explode(px, py, '#64dcff');
        explode(a.x, a.y, '#ff64dc');
        shake = 18;
        endGame();
        return requestAnimationFrame(loop);
      }

      // collision with planet (asteroid destroyed harmlessly)
      const ddx = a.x - cx, ddy = a.y - cy;
      if (ddx * ddx + ddy * ddy < (a.r + planetR) * (a.r + planetR)) {
        explode(a.x, a.y, '#9050d8');
        asteroids.splice(i, 1);
        continue;
      }

      // draw asteroid
      ctx.save();
      ctx.translate(a.x, a.y);
      ctx.rotate(a.rot);
      ctx.fillStyle = '#2a1545';
      ctx.strokeStyle = '#ff64dc';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      const n = a.points.length;
      for (let j = 0; j < n; j++) {
        const ang = (j / n) * Math.PI * 2;
        const rr = a.r * a.points[j];
        const x = Math.cos(ang) * rr;
        const y = Math.sin(ang) * rr;
        if (j === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      ctx.restore();
    }

    // score & difficulty
    score = Math.floor(frame / 6);
    scoreValue.textContent = score;
    difficulty = 1 + score / 60;
  } else if (state === 'menu') {
    // demo orbit
    const demoR = Math.min(W, H) * 0.28;
    const demoA = frame * 0.02;
    const px = cx + Math.cos(demoA) * demoR;
    const py = cy + Math.sin(demoA) * demoR;
    ctx.fillStyle = 'rgba(100, 220, 255, 0.8)';
    ctx.beginPath();
    ctx.arc(px, py, 5, 0, Math.PI * 2);
    ctx.fill();
  }

  // particles
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.vx *= 0.96;
    p.vy *= 0.96;
    p.life -= p.decay;
    if (p.life <= 0) { particles.splice(i, 1); continue; }
    const c = p.color;
    const m = c.match(/^#([0-9a-f]{6})$/i);
    let r = 255, g = 255, b = 255;
    if (m) {
      r = parseInt(m[1].substr(0, 2), 16);
      g = parseInt(m[1].substr(2, 2), 16);
      b = parseInt(m[1].substr(4, 2), 16);
    }
    ctx.fillStyle = `rgba(${r},${g},${b},${p.life})`;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
    ctx.fill();
  }

  ctx.restore();
  requestAnimationFrame(loop);
}

requestAnimationFrame(loop);
</script>
</body>
</html>